{
  "name": "fcu-sigma-backend-examples",
  "version": "1.0.0",
  "description": "FCU Sigma 生態交換平台 - 後端 API 使用範例",
  "type": "module",
  "main": "item_detail_usage_example.js",
  "scripts": {
    "start": "node item_detail_usage_example.js",
    "test": "node item_detail_usage_example.js",
    "test:connection": "node -e \"import('./item_detail_usage_example.js').then(m => m.example5_connectionTest())\"",
    "test:auto": "node -e \"import('./item_detail_usage_example.js').then(m => m.example1_autoGetItemDetails())\"",
    "test:db-location": "node -e \"import('./item_detail_usage_example.js').then(m => m.example2_userLocationFromDB())\"",
    "test:coordinates": "node -e \"import('./item_detail_usage_example.js').then(m => m.example3_useProvidedCoordinates())\"",
    "test:errors": "node -e \"import('./item_detail_usage_example.js').then(m => m.example4_errorHandling())\"",
    "setup": "cp ../.env.example .env && echo '請編輯 .env 檔案設定您的 Supabase 憑證'"
  },
  "keywords": [
    "supabase",
    "postgis",
    "geolocation",
    "api",
    "example",
    "fcu-sigma"
  ],
  "author": "FCU Sigma Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/fcu-sigma"
  },
  "bugs": {
    "url": "https://github.com/your-org/fcu-sigma/issues"
  },
  "homepage": "https://github.com/your-org/fcu-sigma#readme"
}
