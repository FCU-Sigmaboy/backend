# Supabase 配置
# 請將此檔案複製為 .env.staging 並填入您的實際值

# Supabase 專案 URL
# 可在 Supabase Dashboard > Settings > API 中找到
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (公開金鑰)
# 可在 Supabase Dashboard > Settings > API 中找到
# 注意：這是 anon key，不是 service_role key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Key
# 請至 Google Cloud Console 建立並啟用 Maps JavaScript API
# 建議設定 HTTP Referrer 限制，確保只有您的網站能使用此金鑰
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# 本地開發環境
# 如果使用 Supabase 本地開發環境 (supabase start)，請使用以下配置：
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
